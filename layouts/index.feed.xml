{{ printf `<?xml version="1.0" encoding="utf-8"?>` }}<feed xmlns="http://www.w3.org/2005/Atom" ><generator uri="https://gohugo.io/" version="{{ hugo.Version }}">Hugo</generator><link href="https://www.systutorials.com/feed.xml" rel="self" type="application/atom+xml" /><link href="{{ .Permalink }}" rel="alternate" type="text/html" /><updated>{{ (index (where site.RegularPages "Section" "posts").ByDate.Reverse 0).Date.Format "2006-01-02T15:04:05Z07:00" }}</updated><id>https://www.systutorials.com/feed.xml</id><title type="html">{{ .Site.Title }}</title><subtitle>{{ .Site.Params.description }}</subtitle>{{ $posts := where site.RegularPages "Section" "posts" }}{{ range first 10 $posts.ByDate.Reverse }}<entry><title type="html">{{ .Title }}</title><link href="{{ .Permalink }}" rel="alternate" type="text/html" title="{{ .Title }}" /><published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published><updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated><id>{{ strings.TrimSuffix "/" .Permalink }}</id><content type="html" xml:base="{{ .Permalink }}">{{ .Content | html }}</content></entry>{{ end }}</feed>
