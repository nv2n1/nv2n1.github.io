{{ printf `<?xml version="1.0" encoding="UTF-8"?>` | safeHTML }}{{- $manChunkSize := 40000 }}{{- /* must match MAX_URLS in scripts/gen-man-sitemap.py */}}
{{- $manCount := len (where site.RegularPages "Params.section" "!=" nil) }}{{- $manChunks := div (add $manCount (sub $manChunkSize 1)) $manChunkSize }}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap><loc>{{ "sitemap-main.xml" | absURL }}</loc></sitemap>
{{ range seq $manChunks }}  <sitemap><loc>{{ printf "docs/sitemap-%d.xml" . | absURL }}</loc></sitemap>
{{ end }}</sitemapindex>
